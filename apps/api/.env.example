POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts_secret
POSTGRES_DB=ielts_db

# When running via docker compose, host is "postgres" (service name)
# When running locally, host is "localhost"
DATABASE_URL="postgresql://ielts:ielts_secret@postgres:5432/ielts_db"

JWT_SECRET="change_me_in_production"
JWT_REFRESH_SECRET="change_refresh_me_in_production"

FRONTEND_URL="http://localhost:3000"
PORT=4000

# GCP — leave GCP_PROJECT_ID unset for local dev (enables the dev-account
# bypass: POST /auth/dev/login). Set it to enable real Identity Platform auth
# and Vertex AI/Speech/TTS/GCS, using Application Default Credentials
# (`gcloud auth application-default login`) — no key file needed.
GCP_PROJECT_ID=
VERTEX_AI_REGION=global
GCS_UPLOADS_BUCKET_NAME=
GCS_ASSETS_BUCKET_NAME=

# PayPal (sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
