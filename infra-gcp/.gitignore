# Terraform state (stored in GCS, not locally)
*.tfstate
*.tfstate.*

# Terraform secrets (project IDs you don't want public, passwords, etc.)
terraform.tfvars
envs/*.tfvars

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Plan output files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Override files (used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Service account keys — should never exist here; ADC / WIF only (see spec §"data access" note)
*.json
!package*.json
*pem
